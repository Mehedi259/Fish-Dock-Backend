# Fish Dock Backend Environment Variables
SECRET_KEY=fishdock-super-secret-production-key-2026-v1
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Production Database URL (Leave blank to use local SQLite)
DATABASE_URL=postgres://fishdock_user:fishdock_password@postgres:5432/fishdock_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

